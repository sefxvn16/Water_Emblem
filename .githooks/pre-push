#!/bin/sh
# Water Emblem: cổng đầy đủ trước mỗi push. Áp cho mọi AI và người.
# Bật một lần cho mỗi clone: git config core.hooksPath .githooks
# Thứ tự: guard (chống tự sửa cổng) -> done audit (PLAN.md + token) -> gate (test, build, e2e).
# `git push --no-verify` bỏ qua được hook này, nên CI (.github/workflows/gate.yml) chạy lại cả ba.
base=""
while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_sha" in *[!0]*) ;; *) continue ;; esac            # branch deletion: nothing to check
  case "$remote_sha" in *[!0]*) base="$remote_sha" ;; esac        # existing remote branch: diff against it
  break
done
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "gate: note: uncommitted changes are checked too; the pushed commits may differ." >&2
fi
if ! node .studio/guard.mjs; then
  echo "pre-push: guard BLOCK - push bi chan." >&2
  exit 1
fi
if ! node .studio/done.mjs scope; then
  echo "pre-push: thay doi ngoai pham vi da khai bao - push bi chan." >&2
  exit 1
fi
if ! node .studio/done.mjs audit; then
  echo "pre-push: PLAN.md chua dat - push bi chan." >&2
  exit 1
fi
if [ -n "$base" ]; then
  exec node .studio/gate.mjs --base "$base"
fi
exec node .studio/gate.mjs
