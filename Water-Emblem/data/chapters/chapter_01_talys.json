  "name": "Chương 1: Bờ biển Talys (Marth Embarks)",
  "mapId": "chapter_01_talys",
  "objective": {
    "type": "defeat_boss",
    "bossUnitId": "gazzak",
    "descriptionVi": "Hạ gục thủ lĩnh Gazzak (Boss) đang chiếm giữ cổng thành Talys"
  },
  "introLines": [
    {
      "speaker": "Jagen",
      "text": "Điện hạ! Có người vừa từ hoàng thành Talys chạy tới cấp báo. Là Công chúa Caeda!"
    },
    {
      "speaker": "Caeda",
      "text": "Marth, mau cứu lấy phụ vương ta! Toán hải tặc Galder hung hãn bất ngờ tràn lên bờ biển đảo Talys!"
    },
    {
      "speaker": "Marth",
      "text": "Các kỵ sĩ Altea đã tề tựu sẵn sàng. Bọn hải tặc ô hợp không phải là đối thủ của chúng ta! Xuất quân, giải phóng lâu đài Talys!"
    }
  ],
